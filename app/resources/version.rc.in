// The executable's version information (task 8-3a), in place of the one
// JUCE writes, which would describe the exe by its file name. CMake fills
// the @...@ from CMakeLists.txt (app/CMakeLists.txt: configure_file); JUCE
// includes this file through JUCE_USER_DEFINED_RC_FILE.
// The names: the one shown (DE:ZIGN AUDIO PLAYER) describes the product, the
// file's own name stays a name a file can have (CLAUDE.md chapter 1).
#pragma code_page(65001)

#undef  WIN32_LEAN_AND_MEAN
#define WIN32_LEAN_AND_MEAN
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "@AP_COMPANY_NAME@\0"
      VALUE "FileDescription",  "@AP_DISPLAY_NAME@\0"
      VALUE "FileVersion",      "@PROJECT_VERSION@\0"
      VALUE "InternalName",     "@AP_PRODUCT_NAME@\0"
      VALUE "LegalCopyright",   "@AP_COMPANY_NAME@. GNU AGPL v3.\0"
      VALUE "OriginalFilename", "@AP_PRODUCT_NAME@.exe\0"
      VALUE "ProductName",      "@AP_DISPLAY_NAME@\0"
      VALUE "ProductVersion",   "@PROJECT_VERSION@\0"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
