# Normalise line endings for text; never touch audio or other binary data.
* text=auto

# Vendored third-party files are kept byte-for-byte as distributed.
third_party/asiosdk/** -text
third_party/alac/** -text

*.wav  binary
*.aif  binary
*.aiff binary
*.flac binary
*.m4a  binary
*.mp3  binary
*.dsf  binary
*.dff  binary
*.raw  binary
*.pcm  binary
*.png  binary
*.ico  binary
