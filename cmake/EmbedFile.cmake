# Writes a C++ source that holds a file's bytes (cmake -P, see engine/CMakeLists.txt):
#   cmake -DIN=<file> -DOUT=<file.cpp> -DNAME=<identifier> -P EmbedFile.cmake
# The source defines, in namespace ap::engine::embedded:
#   extern const unsigned char NAME[];
#   extern const std::size_t NAMESize;

if(NOT IN OR NOT OUT OR NOT NAME)
    message(FATAL_ERROR "EmbedFile.cmake: IN, OUT and NAME are needed")
endif()

file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" length)
math(EXPR size "${length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
# 16 bytes per line (MSVC is happier with lines of a sane length).
set(sixteen "")
foreach(i RANGE 1 16)
    string(APPEND sixteen "0x[0-9a-f][0-9a-f],")
endforeach()
string(REGEX REPLACE "(${sixteen})" "\\1\n" bytes "${bytes}")

get_filename_component(source_name "${IN}" NAME)
file(WRITE "${OUT}"
"// Generated by cmake/EmbedFile.cmake from ${source_name}. Do not edit.
#include <cstddef>
namespace ap::engine::embedded {
extern const unsigned char ${NAME}[];
extern const std::size_t ${NAME}Size;
const unsigned char ${NAME}[] = {
${bytes}
};
const std::size_t ${NAME}Size = ${size};
} // namespace ap::engine::embedded
")
